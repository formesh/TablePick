.tab-dock { position: fixed; z-index: 20; left: 28rpx; right: 28rpx; bottom: calc(14rpx + env(safe-area-inset-bottom)); padding: 12rpx; display: flex; gap: 6rpx; border-radius: 48rpx; background: #20232a; box-shadow: 0 14rpx 30rpx #161d3433; }
.tab { flex: 1; padding: 12rpx 0 10rpx; margin: 0; height: 96rpx; border-radius: 34rpx; background: transparent; color: #bfc5d1; font-size: 20rpx; line-height: 1.2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; box-sizing: border-box; }
.tab::after { border: 0; }
.active { background: #2f80ff; color: white; }
