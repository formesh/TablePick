<top-bar title="创建点菜房间" />
<view class="shell flow creation">
  <view class="steps"><view class="step active">1 基本信息</view><view class="step active">2 本场菜品</view><view class="step">3 邀请好友</view></view>
  <view wx:if="{{error}}" class="card state">{{error}}<button class="link" bindtap="refresh">重新加载</button></view>
  <block wx:else>
    <view><text class="field-label">房间名称</text><view class="field"><input placeholder="例如：周六晚餐" aria-label="房间名称" maxlength="24" value="{{name}}" bindinput="inputName" /><glyph name="edit" tone="muted" size="{{30}}" /></view></view>
    <view>
      <text class="field-label">使用菜单</text>
      <picker wx:if="{{menu}}" mode="selector" range="{{label}}" value="{{menuIndex}}" bindchange="menuChange"><view class="field between">{{label[menuIndex]}} <glyph name="chevron-down" tone="muted" size="{{27}}" /></view></picker>
      <button wx:elif="{{!loading}}" class="field between new-menu" bindtap="newMenu">先新建一份菜单 <glyph name="plus" size="{{29}}" /></button>
      <view wx:else class="field dim">正在加载菜单…</view>
    </view>
    <view wx:if="{{menu}}">
      <view class="between supply-heading">
        <text class="supply-title">本场供应</text>
        <view class="supply-count">已选 <text>{{selectedIds.length}} / {{menu.dishes.length}}</text></view>
      </view>
      <view class="supply">
        <view wx:for="{{groups}}" wx:key="category" class="supply-group {{expanded === item.category ? 'expanded' : ''}} {{item.dishes.length ? '' : 'empty-group'}}">
          <view class="group-heading">
            <button class="group-expand" disabled="{{!item.dishes.length}}" data-category="{{item.category}}" bindtap="toggleGroup" hover-class="pressed"
              aria-label="{{item.category + (expanded === item.category ? '，收起' : '，展开')}}">
              <view class="supply-icon {{item.tone}}"><glyph name="{{item.icon}}" size="{{30}}" /></view>
              <text class="group-name">{{item.category}}</text>
              <text class="group-count">{{item.dishes.length ? item.count + ' / ' + item.dishes.length : '暂无菜品'}}</text>
              <glyph wx:if="{{item.dishes.length}}" name="{{expanded === item.category ? 'chevron-down' : 'chevron-right'}}" tone="muted" size="{{22}}" />
            </button>
            <button wx:if="{{item.dishes.length}}" class="group-choice" data-category="{{item.category}}" bindtap="toggleAll" hover-class="pressed"
              aria-label="{{item.category + (item.allSelected ? '，取消全选' : '，全选')}}">
              <view class="choice {{item.allSelected ? 'checked' : item.count ? 'partial' : ''}}">
                <glyph wx:if="{{item.count}}" name="{{item.allSelected ? 'check' : 'minus'}}" size="{{23}}" tone="{{item.allSelected ? 'light' : 'blue'}}" />
              </view>
            </button>
          </view>
          <view wx:if="{{expanded === item.category}}" class="supply-dishes">
            <button wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="id" class="dish-option" data-id="{{dish.id}}" bindtap="toggleDish" hover-class="pressed"
              aria-label="{{dish.name + (dish.selected ? '，取消选中' : '，选中')}}">
              <view class="supply-icon dish-icon {{item.tone}}"><glyph name="{{dish.icon}}" size="{{25}}" /></view>
              <text class="dish-name">{{dish.name}}</text>
              <view class="choice {{dish.selected ? 'checked' : ''}}"><glyph wx:if="{{dish.selected}}" name="check" size="{{21}}" tone="light" /></view>
            </button>
          </view>
        </view>
      </view>
    </view>
    <view><text class="field-label">{{autoClose ? '截止时间' : '计划收单时间'}}</text>
      <view class="field deadline">
        <picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="setDate"><view>{{date}} <glyph name="calendar" size="{{28}}" tone="muted" /></view></picker>
        <picker mode="time" value="{{time}}" bindchange="setTime"><view>{{time}} <glyph name="clock" size="{{28}}" tone="muted" /></view></picker>
      </view>
    </view>
    <view class="field between">
      <view><view class="bold">到点自动收单</view><view class="small dim">{{autoClose ? '截止后仅可查看最终清单' : '关闭后由发起人手动收单'}}</view></view>
      <switch checked="{{autoClose}}" color="#2F80FF" bindchange="setAuto" aria-label="到点自动收单" />
    </view>
    <button class="action-button" loading="{{saving}}" disabled="{{saving || loading || !nameReady || !selectedIds.length}}" bindtap="create" hover-class="pressed">创建并邀请好友 <glyph name="arrow-right" size="{{30}}" tone="light" /></button>
  </block>
</view>
