@import "../../styles/dish-presets.wxss";

.edit-card { padding: 18rpx 22rpx; }
.editor-photo { width: 66rpx; height: 66rpx; border-radius: 17rpx; flex: none; }
.dish-heading { text-align: left; width: 100% !important; }
.dish-heading .bold { overflow-wrap: break-word; }
.dish-fields { border-top: 2rpx solid #e8ecf5; padding-top: 15rpx; margin-top: 15rpx; gap: 12rpx; }
.dish-fields .field { background: #f3f5fa; box-shadow: none; min-height: 75rpx; }
.delete { color: #a43e4a; gap: 7rpx; }
.delete-menu { justify-content: center; }
