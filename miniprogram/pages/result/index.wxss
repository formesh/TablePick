.result-shell { gap: 15rpx; }
.result-banner { padding: 35rpx 27rpx 30rpx; background: #12151c; text-align: center; margin-bottom: 12rpx; }
.seal { margin: 0 auto 16rpx; background: #2f80ff; width: 91rpx; height: 91rpx; display: flex; justify-content: center; align-items: center; border-radius: 50%; }
.result-title { font-size: 49rpx; font-weight: 780; overflow-wrap: break-word; }
.result-date { font-size: 23rpx; color: #bfc6d5; margin: 7rpx 0 15rpx; }
.result-stats { display: flex; justify-content: center; gap: 38rpx; }
.result-stats > view { min-width: 57rpx; display: flex; flex-direction: column; gap: 3rpx; font-size: 21rpx; color: #a8aebb; }
.result-stats > view text:first-child { font-size: 40rpx; font-weight: 750; color: white; line-height: 1.12; }
.result-dish { padding: 21rpx 24rpx; }
.dish-title { font-size: 29rpx; }
.portion { margin-top: 10rpx; font-size: 23rpx; }
.result-actions { margin-top: 9rpx; gap: 14rpx; }
