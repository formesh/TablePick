<top-bar title="邀请好友" />
<view class="shell flow invite">
  <view wx:if="{{error}}" class="card state">{{error}}<button class="link" bindtap="refresh">重新加载</button></view>
  <view wx:elif="{{loading}}" class="state">正在准备邀请…</view>
  <block wx:elif="{{room}}">
    <view class="intro"><view class="invite-art"><glyph name="utensils" size="{{62}}" tone="violet" /></view><view class="invite-title">饭局已经准备好</view><view class="small dim">分享给好友，大家就可以一起点菜</view></view>
    <view class="dark-card card-pad flow invite-card">
      <view class="between"><view class="grow"><view class="room-name">{{room.name}}</view><view class="room-note">{{room.menuName}} · {{room.dishesCount}} 道供应</view></view><text class="invite-badge">{{room.closedAt ? '已收单' : '点菜中'}}</text></view>
      <view class="flex"><glyph name="clock" size="{{28}}" tone="soft" />{{deadline}}</view>
      <view class="flex"><glyph name="users" size="{{28}}" tone="soft" />已有 {{room.memberCount}} 人加入</view>
    </view>
    <button class="action-button" wx:if="{{room.inviteToken}}" open-type="share" hover-class="pressed"><glyph name="share" size="{{30}}" tone="light" />分享邀请到微信</button>
    <button class="action-button secondary" bindtap="enter" hover-class="pressed">{{room.closedAt ? '查看最终清单' : '进入点菜房间'}}</button>
  </block>
</view>
