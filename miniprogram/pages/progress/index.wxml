<import src="../../templates/dish-presets.wxml" />
<top-bar title="大家点的" subtitle="{{room.name}}">
  <button slot="action" wx:if="{{room.isHost}}" class="icon-button" bindtap="manage" aria-label="房间管理"><glyph name="more" size="{{36}}" /></button>
</top-bar>
<view class="shell flow progress-shell">
  <view wx:if="{{error}}" class="state card">{{error}}<button class="link" bindtap="refresh">重新加载</button></view>
  <view wx:elif="{{loading && !room}}" class="state">正在加载进度…</view>
  <block wx:elif="{{room && !room.closedAt}}">
    <view class="dark-card card-pad between progress-summary">
      <view class="grow"><view class="summary-title">已确认 {{room.total}} 份</view><view class="small">{{room.memberCount}} 人已加入 · {{room.confirmed}} 人已确认</view></view>
      <button wx:if="{{room.isHost}}" class="action-button compact close-orders" disabled="{{saving}}" bindtap="close"><glyph name="lock" tone="peach" size="{{26}}" />收单</button>
    </view>
    <view class="between"><text class="section-title">成员进度</text><button class="link" wx:if="{{room.isHost}}" bindtap="manage">{{management ? '收起管理' : '管理饭局'}} <glyph name="{{management ? 'chevron-down' : 'chevron-right'}}" size="{{22}}" tone="muted" /></button></view>
    <view class="card card-pad flow manage-panel" wx:if="{{management && room.isHost}}">
      <view class="between"><view><view class="bold">允许好友加入</view><view class="small dim">关闭后，之前的邀请链接会失效</view></view><switch checked="{{room.accepting}}" disabled="{{saving}}" color="#2F80FF" bindchange="toggleInvite" /></view>
      <button wx:if="{{room.inviteToken}}" class="action-button compact" bindtap="invite"><glyph name="share" size="{{25}}" tone="light" />邀请好友</button>
      <button class="action-button secondary add-dish-toggle" disabled="{{saving}}" bindtap="toggleAddDish"><glyph name="{{addingDish ? 'minus' : 'plus'}}" size="{{27}}" tone="blue" />{{addingDish ? '收起加菜表单' : '临时加菜'}}</button>
      <view wx:if="{{addingDish}}" class="flow add-dish-form">
        <text class="small dim">新菜只加入本场饭局。</text>
        <template is="dish-presets" data="{{presets, showPresets, presetDisabled: saving}}" />
        <view class="flex photo-controls">
          <dish-photo class="add-dish-photo" src="{{draftDish.previewPhoto}}" />
          <button class="link" bindtap="choosePhoto" disabled="{{saving}}">{{draftDish.photo ? '更换菜品图' : '上传菜品图'}}</button>
          <button wx:if="{{draftDish.photo}}" class="link" bindtap="useDefaultPhoto" disabled="{{saving}}">使用默认图</button>
        </view>
        <view class="field"><input value="{{draftDish.name}}" placeholder="菜名" maxlength="24" aria-label="菜名" data-field="name" bindinput="editDish" /></view>
        <picker mode="selector" range="{{categories}}" value="{{draftDish.categoryIndex}}" bindchange="setDishCategory">
          <view class="field between"><text>{{categories[draftDish.categoryIndex]}}</text><glyph name="chevron-down" size="{{25}}" tone="muted" /></view>
        </picker>
        <view class="field"><input value="{{draftDish.description}}" placeholder="菜品说明（选填）" maxlength="42" aria-label="菜品说明" data-field="description" bindinput="editDish" /></view>
        <view class="field"><input value="{{draftDish.optionText}}" placeholder="可选做法，例如：微辣、不辣" maxlength="75" aria-label="可选做法" data-field="optionText" bindinput="editDish" /></view>
        <button class="action-button primary" loading="{{saving}}" disabled="{{saving || !dishNameReady}}" bindtap="addDish">加入本场菜单</button>
      </view>
      <view class="delete-actions">
        <button class="link danger-link" disabled="{{saving}}" bindtap="deleteRoom" hover-class="pressed"><glyph name="trash" size="{{24}}" tone="danger" />删除饭局</button>
      </view>
    </view>
    <view class="card member-list">
      <view class="member flex" wx:for="{{room.members}}" wx:key="key">
        <view class="avatar {{item.tone}}">{{item.avatar}}</view>
        <view class="grow"><view class="bold">{{item.name}}{{item.isMe ? '（我）' : ''}}</view><view class="small dim member-description">{{item.itemsLabel}}</view></view>
        <text class="badge {{item.state === 'pending' ? 'amber' : ''}}">{{item.stateText}}</text>
      </view>
    </view>
    <view class="section-title">已确认菜品</view>
    <view class="state card" wx:if="{{!totals.length}}">菜品确认后会在这里汇总。</view>
    <view class="card card-pad between total-dish" wx:for="{{totals}}" wx:key="id">
      <view class="grow"><view class="bold">{{item.name}}</view><view class="small dim">{{item.detail}}</view></view><text class="bold">{{item.count}} 份</text>
    </view>
    <button wx:if="{{room.isHost}}" class="stock-toggle flex" bindtap="showStock"><glyph name="info" size="{{28}}" /> {{stock ? '收起供应管理' : '可临时标记售罄，已点成员会收到提示'}}<glyph name="{{stock ? 'chevron-down' : 'chevron-right'}}" size="{{22}}" /></button>
    <view class="card card-pad" wx:if="{{stock && room.isHost}}">
      <view class="stock-item between" wx:for="{{room.dishes}}" wx:key="id"><text>{{item.name}}</text><button class="link" disabled="{{saving}}" bindtap="stockChange" data-id="{{item.id}}">{{item.soldOut ? '恢复供应' : '标记售罄'}}</button></view>
    </view>
  </block>
</view>
