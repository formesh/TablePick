.progress-shell { gap: 15rpx; }
.progress-summary { padding: 25rpx 29rpx; margin-bottom: 9rpx; }
.summary-title { font-size: 36rpx; font-weight: 750; }
.progress-summary .small { color: #c6ccdb; margin-top: 7rpx; }
.close-orders { background: #ffffff21; min-width: 124rpx; }
.member-list { padding: 4rpx 23rpx; margin-bottom: 9rpx; }
.member { min-height: 94rpx; padding: 15rpx 0; gap: 16rpx; }
.member + .member { border-top: 2rpx solid #eff1f6; }
.member-description { margin-top: 4rpx; overflow-wrap: break-word; }
.total-dish { min-height: 96rpx; padding: 18rpx 23rpx; }
.total-dish .dim { margin-top: 4rpx; }
.stock-toggle { color: #943542; background: #fff1f2; font-size: 23rpx; min-height: 66rpx; padding: 10rpx 20rpx; border-radius: 24rpx; width: 100%; text-align: left; justify-content: flex-start; }
.stock-toggle glyph:last-child { margin-left: auto; }
.stock-item + .stock-item { border-top: 2rpx solid #eff1f6; }
.manage-panel switch { transform: scale(.82); transform-origin: right; }
