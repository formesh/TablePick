<view class="top" style="padding-top:{{top}}px">
  <view class="bar {{centered ? '' : 'leading'}}">
    <button wx:if="{{showBack}}" class="back" bindtap="back" aria-label="返回"><glyph name="chevron-left" size="{{30}}" /></button>
    <view wx:elif="{{centered}}" class="placeholder"></view>
    <view class="titles">
      <view class="title">{{title}}</view><view wx:if="{{subtitle}}" class="subtitle">{{subtitle}}</view>
    </view>
    <view class="action"><slot name="action"></slot></view>
  </view>
</view>
